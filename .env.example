# Live guide generation (required for /generate)
ANTHROPIC_API_KEY=

# Storage for live-generated guides in production: a private Cloudflare R2 bucket (local dev writes to .data/ when unset)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oauth-readiness-guides
DAILY_GENERATION_LIMIT=40

# Setup agent handoff notifications (optional)
NTFY_TOPIC=
NOTIFY_WEBHOOK=
